# ─── Required ────────────────────────────────────────────────────────────────
# YouTube Data API v3 key: console.cloud.google.com → APIs & Services →
# enable "YouTube Data API v3" → Credentials → Create API key.
YOUTUBE_API_KEY=

# Gemini API key (Google AI Studio): aistudio.google.com/apikey
GEMINI_API_KEY=
# Must be a Gemini *Flash* model; the server refuses anything else.
GEMINI_MODEL=gemini-flash-latest

# Supabase: Project Settings → API. Run supabase/schema.sql once in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ─── Optional ────────────────────────────────────────────────────────────────
# Email the Sunday brief (resend.com). Without it the site works; email is just off.
RESEND_API_KEY=
# With onboarding@resend.dev Resend only delivers to your own Resend account email.
BRIEF_FROM_EMAIL="TREND//RADAR <onboarding@resend.dev>"

# Public URL used in email links. On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL.
APP_URL=http://localhost:3300
